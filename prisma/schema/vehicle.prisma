model Vehicle { 
    id Int @id @default(autoincrement())
    type String
    userId Int? @unique @map("user_id")  
    user User? @relation(fields: [userId], references: [id])
    createdAt DateTime @default(now())  @map("created_at")  
    updatedAt DateTime @updatedAt @map("update_at")
    @@map("vehicle")    
}
