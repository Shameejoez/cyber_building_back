model Departament {
    id Int @unique @default(autoincrement())
    name String
    warehouse Warehouse?
    users User[] @relation("DepartmentUsers") 
    brigades Brigade[]

    foremanId Int? @unique @map("foreman_id")
    foreman User? @relation("DepartmentForeman", fields: [foremanId], references: [id])

    brigaderId Int? @unique  @map("brigader_id")
    brigader User? @relation("DepartmentBrigader", fields: [brigaderId], references: [id])

    createdAt DateTime @default(now())  @map("created_at")  
    updatedAt DateTime @updatedAt @map("update_at")

    @@map("departament")
}